# Zenith — Environment Configuration
# Copy this file to .env and fill in the values.

# Required: Secret key for JWT token signing (min 32 chars)
JWT_SECRET=

# Admin credentials (created on first run)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# Database password
DB_PASSWORD=zenith

# Object storage (RustFS, self-hosted, S3-compatible — works on any server/provider)
S3_ACCESS_KEY=zenith
S3_SECRET_KEY=changeme123
S3_REGION=us-east-1
S3_PLATFORM_BUCKET=zenith-platform-storage

# --- Domain and HTTPS (Traefik always runs; Let's Encrypt, resolver `le`) ---
# Dashboard domain. Empty: the installer uses <public-ip>.sslip.io.
# Point <domain> and *.<domain> (A records) at this server for your own domain.
# ZENITH_DOMAIN=
# ACME_EMAIL=you@example.com
# Generated by the installer (64 hex). Encrypts secrets at rest.
# SECRETS_ENCRYPTION_KEY=

# --- Free subdomain automation (Phase B, operator-side only) ---
# Cloudflare API token used by the FreeZenith-operated subdomain-registration
# service to create <slug>.apps.freezenith.com records. NOT needed for a normal
# customer install. Scope it to DNS:Edit on the target zone only, and keep the
# real value in a gitignored .env — never commit it.
# CLOUDFLARE_DNS_TOKEN=

# Resend API key (for email verification, password reset)
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Install mode (set by install.sh; leave commented for a normal install) ---
# Pull zenith-api/zenith-web from another registry (default ghcr.io/taikuri-infra).
# ZENITH_IMAGE_REPO=
# selfsigned = local CA + wildcard cert instead of Let's Encrypt (http01 is the default).
# ZENITH_TLS_MODE=selfsigned
# Path of the local CA inside the API container (selfsigned only).
# ZENITH_TLS_CA_FILE=/etc/zenith/certs/zenith-ca.crt
# Traefik cert resolver for app routers; empty disables ACME (selfsigned), unset means "le".
# ZENITH_CERT_RESOLVER=
# Traefik static config inside the container; unset means /etc/traefik/traefik.yml.
# ZENITH_TRAEFIK_CONFIG=/etc/traefik/traefik.local.yml   # set by `zen install` (every TLS mode) and install.sh (self-signed)
